rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() {
      return signedIn() && exists(memberPath()) && get(memberPath()).data.active == true;
    }
    function googleAccount() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function passPath(serviceId) {
      return /databases/$(database)/documents/services/$(serviceId)/passes/$(request.auth.uid);
    }
    function secretPath(serviceId) {
      return /databases/$(database)/documents/serviceAccess/$(serviceId);
    }
    function hasSundayCode(serviceId) {
      return googleAccount()
        && exists(passPath(serviceId))
        && exists(secretPath(serviceId))
        && get(passPath(serviceId)).data.code == get(secretPath(serviceId)).data.code;
    }
    // Team password: entered once per Google account, valid until the owner changes teamAccess/current.
    function teamPassPath() {
      return /databases/$(database)/documents/teamPasses/$(request.auth.uid);
    }
    function teamSecretPath() {
      return /databases/$(database)/documents/teamAccess/current;
    }
    function hasTeamPassword() {
      return googleAccount()
        && exists(teamPassPath())
        && exists(teamSecretPath())
        && get(teamPassPath()).data.code == get(teamSecretPath()).data.code;
    }
    // Access (John, 2026-10-03, I2): any verified Google account. To go back to a password,
    // replace googleAccount() in these three functions with hasTeamPassword().
    function canUseService(serviceId) {
      return isMember() || googleAccount();
    }
    function isCurrent(serviceId) {
      return get(/databases/$(database)/documents/settings/current).data.serviceId == serviceId;
    }
    function isOpen(serviceId) {
      return get(/databases/$(database)/documents/services/$(serviceId)).data.open == true;
    }
    function canWriteStation(serviceId, stationId) {
      return (isMember()
          && (get(memberPath()).data.role == 'shared'
            || (get(memberPath()).data.role == 'lead'
              && get(memberPath()).data.station == stationId)))
        || googleAccount();
    }
    // Optional display name; must match the Google sign-in name exactly.
    function validName(data) {
      return !('updatedByName' in data)
        || (data.updatedByName is string && data.updatedByName.size() <= 60
          && data.updatedByName == request.auth.token.name);
    }
    function validResponse(stationId) {
      let data = request.resource.data;
      return stationId in ['camera', 'livestream', 'audio', 'onsite-projection', 'fb-projection']
        && data.keys().hasOnly(['checks', 'ready', 'updatedAt', 'updatedBy', 'updatedByName'])
        && data.keys().hasAll(['checks', 'ready', 'updatedAt', 'updatedBy'])
        && data.checks is list && data.checks.size() == 3
        && data.checks[0] is bool && data.checks[1] is bool && data.checks[2] is bool
        && data.ready is bool
        && (!data.ready || (data.checks[0] && data.checks[1] && data.checks[2]))
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && validName(data);
    }
    function canWriteSetup(serviceId) {
      return (isMember() && get(memberPath()).data.role in ['shared', 'director'])
        || googleAccount();
    }
    function validSetup() {
      let data = request.resource.data;
      return data.keys().hasOnly(['checks', 'complete', 'updatedAt', 'updatedBy', 'updatedByName'])
        && data.keys().hasAll(['checks', 'complete', 'updatedAt', 'updatedBy'])
        // 3 church setup checks, then 4 media call time checks (live.js setupItems).
        && data.checks is list && data.checks.size() == 7
        && data.checks[0] is bool && data.checks[1] is bool && data.checks[2] is bool
        && data.checks[3] is bool && data.checks[4] is bool && data.checks[5] is bool
        && data.checks[6] is bool
        && data.complete is bool
        && (!data.complete || (data.checks[0] && data.checks[1] && data.checks[2]
          && data.checks[3] && data.checks[4] && data.checks[5] && data.checks[6]))
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && validName(data);
    }

    // Which camera is on air. cam 0 means neither (slides, intro or countdown on screen).
    function validTally() {
      let data = request.resource.data;
      return data.keys().hasOnly(['cam', 'updatedAt', 'updatedBy', 'updatedByName'])
        && data.keys().hasAll(['cam', 'updatedAt', 'updatedBy'])
        && data.cam is int && data.cam in [0, 1, 2]
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && validName(data);
    }

    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /settings/current {
      allow get: if googleAccount() || isMember();
      allow list, write: if false;
    }
    match /serviceAccess/{serviceId} {
      allow read, write: if false;
    }
    match /teamAccess/{docId} {
      allow read, write: if false;
    }
    match /teamPasses/{uid} {
      allow get: if googleAccount() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if googleAccount() && request.auth.uid == uid
        && exists(teamSecretPath())
        && request.resource.data.keys().hasOnly(['code', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAll(['code', 'updatedAt', 'updatedBy'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 8
        && request.resource.data.code.size() <= 32
        && request.resource.data.code == get(teamSecretPath()).data.code
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    match /services/{serviceId} {
      allow get: if canUseService(serviceId) && isCurrent(serviceId);
      allow list, write: if false;
      match /passes/{uid} {
        allow get: if googleAccount() && request.auth.uid == uid;
        allow list, delete: if false;
        allow create, update: if googleAccount() && request.auth.uid == uid
          && isCurrent(serviceId) && isOpen(serviceId)
          && exists(secretPath(serviceId))
          && request.resource.data.keys().hasOnly(['code', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['code', 'updatedAt', 'updatedBy'])
          && request.resource.data.code is string
          && request.resource.data.code.size() >= 8
          && request.resource.data.code.size() <= 32
          && request.resource.data.code == get(secretPath(serviceId)).data.code
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }
      match /readiness/{stationId} {
        allow get, list: if canUseService(serviceId) && isCurrent(serviceId);
        allow create, update: if canWriteStation(serviceId, stationId) && isCurrent(serviceId)
          && isOpen(serviceId) && validResponse(stationId);
        allow delete: if false;
      }
      match /tally/{tallyId} {
        allow get: if tallyId == 'live' && canUseService(serviceId) && isCurrent(serviceId);
        allow create, update: if tallyId == 'live' && canUseService(serviceId)
          && isCurrent(serviceId) && isOpen(serviceId) && validTally();
        allow list, delete: if false;
      }
      match /setup/{setupId} {
        allow get: if setupId == 'pre-service' && canUseService(serviceId) && isCurrent(serviceId);
        allow create, update: if setupId == 'pre-service' && canWriteSetup(serviceId)
          && isCurrent(serviceId) && isOpen(serviceId) && validSetup();
        allow list, delete: if false;
      }
    }
  }
}
